# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# ⚠️  RESTART REQUIRED: .env is only read when the app starts. After editing this
#     file, restart the app (Ctrl-C, then ./run.sh) or your changes won't apply.

# Required: Claude vision analysis.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional: watch a folder and auto-process clips dropped into it ----
# Point this at the local folder your Dropbox DESKTOP APP syncs into (absolute
# path). Once synced it's a real local file — no Dropbox API needed. Set that
# folder to "Make available offline" in Dropbox so files aren't online-only
# placeholders. Leave WATCH_DIR unset to disable the watcher entirely.
# WATCH_DIR=/Users/you/Dropbox/pickleball-incoming
# WATCH_FOCUS=serve                 # serve | return | dink | drive | general
# WATCH_SUBJECT=player in the white shirt, near side
# WATCH_PROCESSED_DIR=              # default: <WATCH_DIR>/processed
# WATCH_FAILED_DIR=                 # default: <WATCH_DIR>/failed
# WATCH_INTERVAL=1.0                # seconds between sampled frames
# WATCH_MAX_FRAMES=16
# WATCH_POLL_SECONDS=5              # how often to scan the folder

# ---- Optional: email results via Resend (https://resend.com) ----
# Use the "Send test email" button on the home page to confirm delivery.
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=you@example.com
# RESEND_FROM=onboarding@resend.dev # DEFAULT SENDER ONLY DELIVERS TO YOUR OWN
#                                   # Resend account email. Verify a domain and
#                                   # set this to send anywhere.
# APP_BASE_URL=http://localhost:8000
